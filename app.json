{
  "expo": {
    "name": "DriverX",
    "slug": "parkingvalet",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/driverxlogo.jpeg",
    "scheme": "driverapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valetparkingsorganization.valetparking",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app requires camera access to scan QR codes and parking tickets.",
        "NSMicrophoneUsageDescription": "This app requires microphone access for video recording.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to upload parking vehicle images."
      }
    },
    "android": {
      "package": "com.valetparkingsorganization.valetparking",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apikey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/driverxlogo.jpeg",
        "backgroundColor": "#FFD700"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "This app requires camera access to scan QR codes and parking tickets."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/driverxlogo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFD700"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ab2180b-4519-4146-a07f-3b635bdcc439"
      }
    }
  }
}
